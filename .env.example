# ============================================================
# n8n 飞书存档机器人 —— 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# 飞书自建应用凭据（用于建文档 / 发群消息 / 设权限 / 上传图片）
# 取自飞书开放平台 -> 应用详情 -> 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 目标群聊 chat_id（oc_ 开头）
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WordPress / 图片回链所用的公网基址（cpolar 等隧道域名，会周期性变化）
WP_PUBLIC_BASE=https://xxxx.r16.cpolar.top

# 历史旧 App（仅用于批量修历史文档权限，可留空）
OLD_FEISHU_APP_ID=
OLD_FEISHU_APP_SECRET=

# n8n 本地地址（用于脚本调用 / 部署）
N8N_BASE_URL=http://localhost:5678
